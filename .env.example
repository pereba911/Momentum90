# ============================================================
# Momentum 90 · Variables de entorno (copiar a .env.local)
# ============================================================
# Obtén estos valores en Supabase Dashboard:
#   Project Settings → API Keys
# Ambas variables deben pertenecer al MISMO proyecto.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: URL del Edge Function. Por defecto se deriva de VITE_SUPABASE_URL.
VITE_SUPABASE_FUNCTIONS_URL=

# Correo del administrador de la plataforma.
VITE_ADMIN_EMAIL=octaface@gmail.com
